// This header is generated by meson from cak_baked_key.hpp.in via the
// 'DOT_KEYD_CAK_KEY' build option (see meson.build / meson.options). Do not
// edit the generated copy. The CAK is a public key, so embedding it in the
// binary carries no secret-leak risk.

#pragma once

#include <string_view>

namespace dot
{

// clang-format off
// True when a CAK public key was baked in at build time (-DDOT_KEYD_CAK_KEY=...).
inline constexpr bool kCakKeyBaked = @cak_key_baked@;

// The raw baked-in CAK PEM public key. May contain escaped "\n" sequences;
// callers normalize it via normalizePemKeyFormat() before use. Empty when no
// key was baked in.
inline constexpr std::string_view kCakKeyBakedPem =
    R"CAKPEM(@cak_key_pem@)CAKPEM";
// clang-format on

} // namespace dot
