[Unit]
Description=ConnectX Recovery Utility
Wants=xyz.openbmc_project.ObjectMapper.service
After=xyz.openbmc_project.ObjectMapper.service
Wants=xyz.openbmc_project.EntityManager.service
After=xyz.openbmc_project.EntityManager.service

[Service]
Type=oneshot
RemainAfterExit=no
Environment="ARGS=%I"
SyslogIdentifier=connectx-recovery.sh
ExecStart=/usr/bin/mst-recovery --device-type ConnectX $ARGS
