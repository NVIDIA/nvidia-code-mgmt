[Unit]
Description=NVSwitch Recovery Utility
Wants=xyz.openbmc_project.ObjectMapper.service
After=xyz.openbmc_project.ObjectMapper.service
Wants=xyz.openbmc_project.EntityManager.service
After=xyz.openbmc_project.EntityManager.service

[Service]
Type=oneshot
Environment="ARGS=%I"
SyslogIdentifier=nvswitch-recovery.sh
ExecStart=/usr/bin/mst-recovery --device-type NVSwitch $ARGS
