[Unit]
Description=OpenBMC MCU Recovery Updater
Wants=xyz.openbmc_project.ObjectMapper.service
After=xyz.openbmc_project.ObjectMapper.service
Wants=pldmd.service
After=pldmd.service
Wants=xyz.openbmc_project.FruDevice.service
After=xyz.openbmc_project.FruDevice.service

[Service]
EnvironmentFile=/etc/mcurecovery/mcurecovery.env
ExecStart=/usr/bin/code-manager -u MCURecovery -i %i
Restart=always
Type=dbus
# FRU variant detection waits up to 300 s before the bus name is claimed
TimeoutStartSec=330
BusName=com.Nvidia.Software.MCURecovery.Updater.%i
