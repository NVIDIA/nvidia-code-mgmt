[Unit]
Description=MCU Recovery Updater Starter Service
Wants=pldmd.service
After=pldmd.service
Wants=xyz.openbmc_project.EntityManager.service
After=xyz.openbmc_project.EntityManager.service

[Service]
# Keeps starting updaters as Entity Manager publishes their packages for up
# to 300 s; exec so that window never holds up multi-user.target.
Type=exec
ExecStart=/usr/bin/code-manager -u MCURecoveryStarter

[Install]
WantedBy=multi-user.target
