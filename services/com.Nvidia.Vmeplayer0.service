[Unit]
Description=VMEPlayer CPLD_0 update over JTAG
Wants=pldmd.service
After=pldmd.service
Wants=obmc-mapper.target
After=obmc-mapper.target

[Service]
ExecStart=/usr/bin/code-manager -u VMEPLAYER -i vme0 -m CPLD0_MODEL
Restart=always
Type=dbus
BusName=com.Nvidia.Software.Vmeplayer.Updater.vme0

[Install]
WantedBy=multi-user.target
